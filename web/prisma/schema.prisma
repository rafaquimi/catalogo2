// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Family {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts Part[]
}

model Part {
  id          String   @id @default(cuid())
  description String
  priceCents  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Restrict)

  images     PartImage[]
  quoteItems QuoteItem[]

  @@index([familyId])
}

model PartImage {
  id        String   @id @default(cuid())
  url       String
  createdAt DateTime @default(now())

  partId String
  part   Part   @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
}

// Registro de intentos fallidos de login para rate limiting
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String   @default("unknown")
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Historial inmutable de las operaciones sensibles realizadas en el catálogo.
// No se relaciona con User para conservar el registro aunque cambie la cuenta.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String
  action      String
  entityType  String
  entityId    String?
  summary     String
  changes     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

// Datos editables de la empresa emisora. La aplicación utiliza una sola fila.
model CompanySettings {
  id                  String   @id @default("default")
  businessName        String   @default("")
  taxId               String   @default("")
  address             String   @default("")
  postalCode          String   @default("")
  city                String   @default("")
  province            String   @default("")
  phone               String   @default("")
  email               String   @default("")
  website             String   @default("")
  logoUrl             String?
  quotePrefix         String   @default("PRE")
  defaultValidityDays Int      @default(30)
  defaultTaxBps       Int      @default(2100)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]

  @@index([name])
  @@index([phone])
}

model QuoteCounter {
  year      Int      @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Quote {
  id            String   @id @default(cuid())
  number        String   @unique
  status        String   @default("DRAFT")
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName  String
  customerPhone String
  customerEmail String?
  issueDate     DateTime @default(now())
  validUntil    DateTime
  notes         String?
  taxRateBps    Int      @default(2100)
  taxBaseCents  Int
  taxCents      Int
  totalCents    Int
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items      QuoteItem[]
  deliveries QuoteDelivery[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model QuoteItem {
  id             String  @id @default(cuid())
  quoteId        String
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  partId         String?
  part           Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)
  description    String
  quantity       Int
  unitPriceCents Int
  discountBps    Int     @default(0)
  totalCents     Int
  position       Int

  @@index([quoteId, position])
  @@index([partId])
}

model QuoteDelivery {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  channel   String
  recipient String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([quoteId, createdAt])
}
